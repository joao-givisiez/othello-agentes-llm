# Copie este arquivo para .env e preencha a chave do provedor que for usar.

# Modelo usado pelos agentes LLM, no formato "provedor:modelo" do LangChain.
# Exemplos:
#   anthropic:claude-opus-5-5     (padrão)
#   anthropic:claude-haiku-5-5    (mais barato/rápido para muitas partidas)
#   groq:openai/gpt-oss-120b      (requer langchain-groq e GROQ_API_KEY)
#   openai:gpt-4.1-mini           (requer langchain-openai)
#   ollama:llama3.1               (local, requer langchain-ollama e Ollama rodando)
OTHELLO_LLM_MODEL=anthropic:claude-opus-5-5

# Esforço de raciocínio (modelos Anthropic e gpt-oss no Groq): low | medium | high
# OTHELLO_LLM_EFFORT=low

ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
